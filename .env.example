# Firebase 接続用環境変数 (Stage 3 / 2026-05-13)
# 本ファイルは安全な placeholder。
# 実値は `.env.local` に書く (gitignore 済) か CI Secrets から注入する。
#
# 取得方法: Firebase Console → プロジェクト設定 → 全般 → マイアプリ →
#   Web app の SDK 構成 (firebaseConfig) を Vite env 形式に展開
#
# 注: Firebase の apiKey はクライアント配布可能 (security rules で保護)。
# ただし VITE_FIREBASE_* 接頭辞はビルド時に bundle に埋め込まれるので、
# サーバー専用 secret は絶対に置かない。
VITE_FIREBASE_API_KEY=__SET_ME__
VITE_FIREBASE_AUTH_DOMAIN=tadakayo-game-yh.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tadakayo-game-yh
VITE_FIREBASE_STORAGE_BUCKET=tadakayo-game-yh.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=__SET_ME__
VITE_FIREBASE_APP_ID=__SET_ME__
